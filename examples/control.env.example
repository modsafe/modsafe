# modsafe control（控制面，默认监听 127.0.0.1:9443）
# ★ 必填项缺失时进程拒绝启动（fail-fast）——门户登录 OAuth 三元组

# ── 必填：门户 OAuth 三元组（与 oa2 config.yaml 的 client 口径一致）──
# adapter 对外基址（用户浏览器可达；门户登录跳转 /authorize 用它）
MODSAFE_ADAPTER_PUBLIC_URL=https://sso.example.com
MODSAFE_PORTAL_CLIENT_ID=<oa2-client-id>
MODSAFE_PORTAL_CLIENT_SECRET=<oa2-client-secret>

# ── 可选 ──────────────────────────────────────────────────────────
# 监听地址（默认 127.0.0.1:9443，公网暴露须经 nginx TLS 反代）
#MODSAFE_ADDR=127.0.0.1:9443
# 门户对外基址（管理台「门户地址」设置的种子值；设置后 DB 可覆盖）
#MODSAFE_PORTAL_BASE=https://portal.example.com
# .ovpn 签发接入地址种子（"host port"；也可在管理台「通用设置」维护）
#MODSAFE_VPN_REMOTE=vpn.example.com 1194
# 内网 LVS VIP（.ovpn 第二 remote 回退 + VIP 视角探测）
#MODSAFE_DIRECTOR_VIP=10.0.0.100
# node-2 节点代理基址（跨机踢线用；单机留空）
#NODE_AGENT_193=http://10.0.0.11:7503
# 首次启动初始化 admin 口令；不设置则生成随机口令并打印在启动日志中（请立即登录修改）
#MODSAFE_ADMIN_PASSWORD=
# Ed25519 license 公钥（hex 编码），覆盖编译内置公钥；等价方式：data/license.pub
#MODSAFE_LICENSE_PUB=<hex-encoded-ed25519-public-key>
