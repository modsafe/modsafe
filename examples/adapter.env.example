# modsafe adapter（认证适配器，默认监听 :8000）
# 变量名以代码 os.Getenv 为准；复制为实际 env 文件后按环境填写
# ★ 必填项缺失时进程拒绝启动（fail-fast，不带弱默认运行）

# ── 必填：部署拓扑三要素 ────────────────────────────────────────────
# 本机服务基址（issuer 由此派生）
ADAPTER_BASE=https://sso.example.com
# 认证网关（openvpn-auth-oauth2）基址
OA2_BASE=https://sso.example.com:9000
# 对外门户基址（redirect 白名单/CORS 由它与 ADAPTER_BASE 派生；同机同源部署可留空=回退 ADAPTER_BASE）
#MODSAFE_PORTAL_BASE=https://portal.example.com

# ── 可选 ──────────────────────────────────────────────────────────
# 监听端口（默认 8000；仅灰度并行时需要覆盖）
#ADAPTER_PORT=8000
# 冒烟模式开关（灰度并行验证用途）
#ADAPTER_SMOKE=1
# 控制面地址（默认 http://127.0.0.1:9443，同机部署无需修改）
#CONTROL_PLANE_URL=http://127.0.0.1:9443
# 控制面对外管理来源（logout CORS 白名单追加项，如 https://vpn.example.com:9443）
#MODSAFE_ADMIN_ORIGIN=
# redirect 白名单整体替换（逗号分隔；默认由门户/本机基址派生，一般无需设置）
#MODSAFE_REDIRECT_URIS=
# 追加 redirect 条目（逗号分隔）
#MODSAFE_EXTRA_REDIRECT_URIS=
# node-2 节点代理基址（双节点网段下发用；单机部署留空）
#NODE_AGENT_193=http://10.0.0.11:7503
# .ovpn 签发 remote 端点（逗号分隔 "host port" 对；留空=adapter 侧签发报错）
#MODSAFE_OVPN_REMOTES=vpn.example.com 1194
# 钉钉扫码登录应用凭据（钉钉开放平台颁发；也可走 idp-config.json）
#DINGTALK_CLIENT_ID=
#DINGTALK_CLIENT_SECRET=
# webhook 通知目标默认拒绝环回/链路本地/私网地址（防 SSRF），=1 显式放行
#MODSAFE_NOTIFY_ALLOW_PRIVATE=
