# modsafe nodeagent（节点代理 :7503 / 会话采集 :7505）

# ── 可选：双机 HA watchdog（单机部署全部留空，watchdog 自动禁用）──
# LVS 虚拟服务地址（VIP:端口）
#MODSAFE_WATCH_VIP=10.0.0.100:1194
# 两个真实节点的 OpenVPN 服务地址（ip:端口）
#MODSAFE_WATCH_RS1=10.0.0.10:11941
#MODSAFE_WATCH_RS2=10.0.0.11:11942
# 控制面健康探测完整 URL（未配置=跳过该探测）
#MODSAFE_CONTROL_HEALTHZ=https://portal.example.com:9443/api/v1/healthz
# 对端节点代理基址（collector 集群汇总用；单机留空=自动跳过）
#NODE_AGENT_193=http://10.0.0.11:7503
# 单机版显式声明（=0 不探测 node-2；未配 NODE_AGENT_193 时同样自动跳过）
#MODSAFE_CLUSTER_MODE=0
# webhook 通知目标默认拒绝环回/链路本地/私网地址（防 SSRF），=1 显式放行
#MODSAFE_NOTIFY_ALLOW_PRIVATE=1
