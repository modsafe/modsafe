<?xml version="1.0" encoding="utf-8"?>
<!-- Modsafe 信任锚（#134 通用化）：不 pin 特定域名——门户域名首启配置后由应用层
     白名单（PortalConfig.allowedHosts）校验；TLS 层信任系统 CA + 捆绑的产品根 CA
     （opensec.crt，自签锚，覆盖内网直连与私有部署）。 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/opensec" />
        </trust-anchors>
    </base-config>
</network-security-config>
